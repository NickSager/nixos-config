{
  "env": {
    "AWS_PROFILE": "claude",
    "AWS_REGION": "us-west-2",
    "ANTHROPIC_SMALL_FAST_MODEL_AWS_REGION": "us-west-2",
    "CLAUDE_CODE_USE_BEDROCK": "0",
    "DISABLE_BUG_COMMAND": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_TELEMETRY": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(done)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(rg:*)",
      "Bash(jq:*)",
      "Bash(wc:*)",
      "Bash(echo:*)",
      "Bash(readlink:*)",
      "Read(~/.claude/plans/**)",
      "Bash(xargs ls:*)",
      "Bash(xargs grep:*)",
      "Bash(xargs find:*)",
      "Bash(cd:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git rev-parse:*)",
      "Bash(git branch --show-current)",
      "Bash(git branch -v)",
      "Bash(git branch -a)",
      "Bash(git branch --list:*)",
      "Bash(git -C:*)",
      "Bash(tmux capture-pane:*)",
      "Bash(tmux list-windows:*)",
      "Bash(tmux list-sessions:*)",
      "Bash(tmux send-keys:*)",
      "Bash(tmux display-message:*)",
      "Bash(tmux new-window:*)",
      "Bash(tmux load-buffer:*)",
      "Bash(tmux paste-buffer:*)",
      "Bash(tmux kill-window:*)",
      "Bash(tmux has-session:*)",
      "Bash(tmux new-session:*)",
      "Bash(unzstd:*)",
      "Bash(zstdcat:*)",
      "Read(~/.claude/**)",
      "Read(**/.claude/**)",
      "Read(~/Documents/Notes/**)",
      "Read(**/Documents/Notes/**)",
      "Read(/nix/store/**/Documents/Notes/**)",
      "Bash(install -m 644 ~/Documents/Notes/Main/Templates/*.md ~/Documents/Notes/Main/Daily_Notes/**)",
      "Bash(install -m 644 /Users/nsager/Documents/Notes/Main/Templates/*.md /Users/nsager/Documents/Notes/Main/Daily_Notes/**)",
      "Edit(~/Documents/Notes/Main/Daily_Notes/**)",
      "Edit(**/Documents/Notes/Main/Daily_Notes/**)",
      "Write(~/Documents/Notes/Main/Daily_Notes/**)",
      "Write(**/Documents/Notes/Main/Daily_Notes/**)",
      "Read(~/Documents/Mind/**)",
      "Read(**/Documents/Mind/**)",
      "Edit(~/Documents/Mind/**)",
      "Edit(**/Documents/Mind/**)",
      "Write(~/Documents/Mind/**)",
      "Write(**/Documents/Mind/**)"
    ]
  },
  "model": "us.anthropic.claude-fable-5",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "superpowers@superpowers-dev": true,
    "mattpocock-skills@mattpocock": false
  },
  "extraKnownMarketplaces": {
    "superpowers-dev": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers",
        "ref": "v6.3.0"
      }
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills",
        "ref": "v1.2.3"
      }
    }
  },
  "outputStyle": "STE",
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "autoMemoryDirectory": "~/Documents/Mind/memories",
  "skipWorkflowUsageWarning": true,
  "autoCompactEnabled": true
}
