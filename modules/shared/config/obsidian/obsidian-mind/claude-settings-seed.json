{
  "awsAuthRefresh": "ada credentials update --profile claude --account $ISENGARD_ACCT --provider isengard --role Admin --once",
  "env": {
    "AWS_PROFILE": "claude",
    "AWS_REGION": "us-west-2",
    "ANTHROPIC_SMALL_FAST_MODEL_AWS_REGION": "us-west-2",
    "CLAUDE_CODE_USE_BEDROCK": "1",
    "DISABLE_BUG_COMMAND": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_TELEMETRY": "1"
  },
  "model": "global.anthropic.claude-fable-5",
  "alwaysThinkingEnabled": true,
  "includeCoAuthoredBy": true,
  "autoMemoryDirectory": "~/Documents/Notes/AI/memory",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "hooks": {
    "SessionStart": [{
      "matcher": "startup|resume|clear|compact",
      "hooks": [{
        "type": "command",
        "command": "bash ~/Documents/Notes/.claude/scripts/session-start.sh",
        "timeout": 30
      }]
    }],
    "UserPromptSubmit": [{
      "hooks": [{
        "type": "command",
        "command": "bash ~/Documents/Notes/.claude/scripts/find-python.sh ~/Documents/Notes/.claude/scripts/classify-message.py",
        "timeout": 15
      }]
    }],
    "PostToolUse": [{
      "matcher": "Write|Edit",
      "hooks": [{
        "type": "command",
        "command": "bash ~/Documents/Notes/.claude/scripts/find-python.sh ~/Documents/Notes/.claude/scripts/validate-write.py",
        "timeout": 15
      }]
    }],
    "PreCompact": [{
      "hooks": [{
        "type": "command",
        "command": "bash ~/Documents/Notes/.claude/scripts/pre-compact.sh",
        "timeout": 30
      }]
    }],
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "echo 'Session end checklist:\n- Archive completed projects? (AI/work/active/ -> AI/work/archive/YYYY/)\n- Update indexes? (AI/work/Index.md, AI/brain/Memories.md, AI/org/People & Context.md, AI/perf/Brag Doc.md)\n- New notes linked? (orphans are bugs)\n- Run /om-vault-audit if many notes were created/modified'",
        "timeout": 5
      }]
    }]
  },
  "permissions": {
    "allow": [
      "Bash(done)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(rg:*)",
      "Bash(jq:*)",
      "Bash(wc:*)",
      "Bash(echo:*)",
      "Bash(readlink:*)",
      "Read(~/.claude/plans/**)",
      "Bash(xargs ls:*)",
      "Bash(xargs grep:*)",
      "Bash(xargs find:*)",
      "Bash(cd:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git rev-parse:*)",
      "Bash(git branch --show-current)",
      "Bash(git branch -v)",
      "Bash(git branch -a)",
      "Bash(git branch --list:*)",
      "Bash(git -C:*)",
      "Bash(~/Documents/Notes/.claude/scripts/ws-git-log.sh:*)",
      "Bash(tmux capture-pane:*)",
      "Bash(tmux list-windows:*)",
      "Bash(tmux list-sessions:*)",
      "Bash(tmux send-keys:*)",
      "Bash(tmux display-message:*)",
      "Bash(tmux new-window:*)",
      "Bash(tmux load-buffer:*)",
      "Bash(tmux paste-buffer:*)",
      "Bash(tmux kill-window:*)",
      "Bash(tmux has-session:*)",
      "Bash(tmux new-session:*)",
      "mcp__builder-mcp__ReadInternalWebsites",
      "mcp__builder-mcp__TicketingReadActions",
      "mcp__builder-mcp__InternalSearch",
      "mcp__builder-mcp__InternalCodeSearch",
      "mcp__builder-mcp__GetPipelineDetails",
      "mcp__builder-mcp__ApolloReadActions",
      "mcp__builder-mcp__OncallReadActions",
      "mcp__builder-mcp__WorkspaceGitDetails",
      "mcp__builder-mcp__MechanicDiscoverTools",
      "mcp__builder-mcp__MechanicDescribeTool",
      "mcp__waf-dp-triage__classify_ticket",
      "mcp__waf-dp-triage__poll_new_tickets",
      "mcp__waf-dp-triage__mhs_command",
      "mcp__waf-dp-triage__check_command",
      "mcp__waf-dp-triage__query_goku_kb",
      "mcp__waf-dp-triage__analyze_log_content",
      "mcp__waf-dp-triage__record_processed",
      "Bash(unzstd:*)",
      "Bash(zstdcat:*)",
      "Read(//Volumes/workplace/Ops/**)",
      "Read(~/.claude/**)",
      "Read(**/.claude/**)",
      "Read(~/Documents/Notes/**)",
      "Read(**/Documents/Notes/**)",
      "Read(~/Documents/Notes/AI/**/.state/**)",
      "Read(**/Documents/Notes/AI/**/.state/**)",
      "Write(~/Documents/Notes/AI/**/.state/**)",
      "Write(**/Documents/Notes/AI/**/.state/**)",
      "Read(/nix/store/**/Documents/Notes/**)",
      "Edit(~/Documents/Notes/AI/**)",
      "Edit(**/Documents/Notes/AI/**)",
      "Write(~/Documents/Notes/AI/**)",
      "Write(**/Documents/Notes/AI/**)",
      "Edit(~/Documents/Notes/Main/Daily_Notes/**)",
      "Edit(**/Documents/Notes/Main/Daily_Notes/**)",
      "Write(~/Documents/Notes/Main/Daily_Notes/**)",
      "Write(**/Documents/Notes/Main/Daily_Notes/**)"
    ]
  }
}
