+
+/**
+ * Same as listMarkdownSources but walks subdirectories too. work/active groups
+ * multi-note workstreams into `active/<Topic>/` folders (CLAUDE.md § Creating
+ * Notes 5), so a flat read makes every grouped project's tasks invisible —
+ * exactly the projects big enough to have earned a folder.
+ */
+function listMarkdownSourcesDeep(
+	dir: string,
+	skip: (name: string) => boolean = () => false,
+): { path: string; content: string }[] {
+	let entries: Dirent[];
+	try {
+		entries = readdirSync(dir, { withFileTypes: true });
+	} catch {
+		return [];
+	}
+	const sources: { path: string; content: string }[] = [];
+	for (const e of entries) {
+		if (skip(e.name)) continue;
+		const path = `${dir}/${e.name}`;
+		if (e.isDirectory()) {
+			sources.push(...listMarkdownSourcesDeep(path, skip));
+		} else if (e.isFile() && isMarkdownFilename(e.name)) {
+			const src = readMarkdownSource(path);
+			if (src !== null) sources.push(src);
+		}
 	}
 	return sources;
 }
