filters:
  and:
    - file.ext == "md"
    - '!file.inFolder("templates")'
properties:
  file.name:
    displayName: Note
  description:
    displayName: Summary
  status:
    displayName: Status
  due:
    displayName: Due date
views:
  - type: table
    name: Active Work
    filters:
      and:
        - file.hasTag("work-note")
        - status == "active"
        - file.inFolder("work/active")
    groupBy:
      property: project
      direction: ASC
    order:
      - file.name
      - description
      - due
    sort:
      - property: file.mtime
        direction: DESC
  - type: table
    name: Recently Touched
    filters:
      and:
        - file.mtime > now() - "7 days"
        - file.inFolder("work/active")
        - '!file.hasProperty("source_repo")'
    order:
      - file.name
      - description
      - due
    sort:
      - property: file.mtime
        direction: DESC
    limit: 15
